# 统一换行符：索引与检出都使用 LF，避免 Windows 编辑器产生大量 CRLF 噪音 diff
* text=auto eol=lf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.jar   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.so    binary
