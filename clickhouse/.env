# ClickHouse 账号密码等外部配置
# 修改后执行：docker compose up -d --force-recreate clickhouse （首次或改密码后需要重建容器）
# 注意：容器启动时才会把这里的账号密码写入 users.d/default-user.xml

# 业务账号（容器启动时自动创建，同时禁用镜像自带的 default 用户外部访问）
# 只能用字母/数字/下划线，且不能以数字开头（会作为 xml 标签名）
CLICKHOUSE_USER=bluefrog

# 账号密码（明文，容器启动时生成对应的 sha256 配置）
# 建议只用字母数字，避免 xml 特殊字符（& < > " '）导致生成的配置出错
CLICKHOUSE_PASSWORD=12345678

# 可选：启动时自动创建的数据库，留空表示不创建
CLICKHOUSE_DB=

# 是否允许该账号管理用户/权限：1=允许，0=不允许
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1
