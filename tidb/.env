# TiDB 账号密码等外部配置
# 作用：docker compose 中的 tidb-init 服务启动后会用这里的密码去设置 TiDB 的 root 账号
# 生效方式：修改后执行 docker compose up -d --force-recreate tidb-init
#          （或整体 docker compose up -d，然后 docker compose logs -f tidb-init 看结果）

# TiDB 管理员账号，内置账号名就是 root，一般不用改
TIDB_ROOT_USER=root

# root 账号的登录密码（必填，TiDB 默认密码为空）
TIDB_ROOT_PASSWORD=123456
