# ActiveMQ 外部配置
# 生效方式：修改后执行 docker compose up -d --force-recreate
#          （只改了账号密码/内存：docker compose up -d --force-recreate activemq）

# 镜像版本（官方镜像 apache/activemq-classic）
#   * 6.x 需要 Java 17+ 的客户端（服务端镜像自带 JDK）
#   * 如果你的客户端还在 Java 8/11，改成 5.18.x（如 5.18.7），端口和用法完全一样
#   * 报 manifest unknown 说明这个 tag 不存在，去 Docker Hub 上换一个现有的 tag 即可
ACTIVEMQ_VERSION=6.1.6

# Web 控制台账号（http://localhost:8161/）
# 变量名必须是镜像 entrypoint.sh 认的 ACTIVEMQ_WEB_USER / ACTIVEMQ_WEB_PASSWORD
# （它会把 conf/users.properties 改成这两个值；默认是 admin/admin）。
# 注意 ACTIVEMQ_ADMIN_LOGIN / ACTIVEMQ_ADMIN_PASSWORD 这个镜像不认，写了也没用。
# 用户名建议保持 admin：镜像默认 conf/groups.properties 是 admins=admin，改用户名还要同步改 groups.properties。
# 另外这只是「控制台」的登录账号；broker 本身默认没开鉴权（61616 谁都能连），要开见 Readme 常见问题 8。
ACTIVEMQ_WEB_USER=admin
ACTIVEMQ_WEB_PASSWORD=123456

# JVM 参数：只能用 ACTIVEMQ_OPTS 整串覆盖，改 ACTIVEMQ_OPTS_MEMORY 是不生效的！
# 原因：镜像 Dockerfile 里已经设了完整的 ACTIVEMQ_OPTS
#   -Xms64M -Xmx1G -Djava.util.logging.config.file=logging.properties \
#   -Djava.security.auth.login.config=/opt/apache-activemq/conf/login.config -Djetty.host=0.0.0.0
# 而 bin/activemq 只有在 ACTIVEMQ_OPTS 为空时才去读 ACTIVEMQ_OPTS_MEMORY。
# 下面把内存换成了自己的值，后面几个 -D 必须原样保留：
#   少了 -Djetty.host=0.0.0.0         → 控制台只监听容器内 127.0.0.1，宿主机 8161 打不开
#   少了 -Djava.security.auth.login.config → 控制台登录会异常（JAAS 配置读不到）
# 机器内存紧张就把 -Xms/-Xmx 调小，例如 -Xms128m -Xmx512m
ACTIVEMQ_OPTS=-Xms256m -Xmx1g -Djava.util.logging.config.file=logging.properties -Djava.security.auth.login.config=/opt/apache-activemq/conf/login.config -Djetty.host=0.0.0.0

# 可选：给 broker 开连接鉴权（默认关闭，61616/61613/11883 谁都能连）
# entrypoint 会改 conf/credentials.properties 并往 activemq.xml 插入 simpleAuthenticationPlugin
# ACTIVEMQ_CONNECTION_USER=admin
# ACTIVEMQ_CONNECTION_PASSWORD=123456

# 可选：打开 JMX 连接器（默认 createConnector="false"，即容器内不监听 1099）
# 开了之后记得把 1099:1099 加进 docker-compose.yml 的 ports
# ACTIVEMQ_JMX_USER=admin
# ACTIVEMQ_JMX_PASSWORD=activemq
