# MongoDB 外部配置（镜像版本 + 超级管理员账号）
# 改完执行：docker compose up -d --force-recreate

# 镜像版本：固定大版本，别再用 mongo:latest（会随上游跳到 8.3/9.x）
#   8.0  当前 LTS（8.0.32），推荐
#   8.3  最新快速迭代线（8.3.11），也就是现在的 latest
#   7.0  上一代 LTS
# 注意：数据目录不能降级使用（8.x 的数据目录拿 7.0 启动会报 featureCompatibilityVersion 错误），
#       换大版本前先备份，见 Readme「常见问题 9」
MONGO_VERSION=8.0

# 传给容器的 GLIBC_TUNABLES，用来覆盖官方镜像自带的 glibc.pthread.rseq=0。
# 原因：Linux 内核 6.19 ~ 7.0.13 改了 rseq 行为，和 MongoDB 内置 TCMalloc 的 per-CPU 缓存冲突，
#       8.0.21+ / 8.3.0+ 会直接拒绝启动（SERVER-121912 / SERVER-125742）：
#       "MongoDB cannot start: Linux kernel versions 6.19 and newer has a known incompatibility"
#   glibc.pthread.rseq=1  各内核都能起（默认，代价是 TCMalloc per-CPU 缓存用不上，本地开发无感）
#   glibc.pthread.rseq=0  只在内核 < 6.19 或 >= 7.0.14 时这么设，性能最接近镜像默认
# 自查内核：uname -r ；详见 Readme「常见问题 14」
MONGO_GLIBC_TUNABLES=glibc.pthread.rseq=1

# 超级管理员（在 admin 库），只在「数据目录为空」的首次启动时创建一次。
# 之后再改这里不会改密码，要用 mongosh 改，见 Readme「常见问题 5」
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=123456
