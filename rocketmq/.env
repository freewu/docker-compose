# RocketMQ 外部配置（NameServer / Broker / Dashboard 都读这里）
# 生效方式：改完执行 docker compose up -d --force-recreate
#          （只改了 HOST_IP 时重建 broker 即可：docker compose up -d --force-recreate broker）

# 镜像版本（apache/rocketmq；NameServer 与 Broker 是同一个镜像，升级只改这一处）
ROCKETMQ_VERSION=5.3.2

# 控制台（rocketmq-dashboard）镜像版本
ROCKETMQ_DASHBOARD_VERSION=2.0.0

# 宿主机局域网 IP（必填，不能是 127.0.0.1 / localhost / 容器 IP）
# 作用：写入 config/broker.conf 的 brokerIP1 —— broker 通告给客户端的「连接地址」。
#   * 宿主机上的应用（Java/Python/Go SDK）靠它找到 broker，填错会报连接超时
#     （sendDefaultImpl call timeout / connect to <ip>:10911 failed）
#   * 探测当前 IP：../redis-cluster/set-host-ip.sh --print
#   * 换了网络（IP 变了）要改这里并重建 broker 容器，否则客户端会连不上
HOST_IP=192.168.110.141

# JVM 内存（镜像自带脚本认 JAVA_OPT_EXT，会追加到默认参数后面，所以能覆盖默认值）
# 不填则用镜像默认（NameServer 4g、Broker 8g），内存紧张的开发机建议按下面调小
NAMESRV_JAVA_OPT_EXT=-Xms512m -Xmx512m -Xmn256m
BROKER_JAVA_OPT_EXT=-Xms1g -Xmx1g -Xmn512m
