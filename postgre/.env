# PostgreSQL 外部配置（镜像版本 / 账号密码 / 初始库）
# 生效方式：改完执行 docker compose up -d --force-recreate
#
# ！重要：POSTGRES_* 只在「数据目录还是空的」首次初始化时生效。
#   已经有数据之后再改这里的密码，数据库里已有账号的密码不会跟着变（见 Readme 常见问题 6）。

# 镜像版本：**必须固定大版本**。
#   原来写的是 image: postgres（不带 tag），会跟着 latest 走，而 latest 现在已经是 18 了：
#   18 改了数据目录布局（PGDATA=/var/lib/postgresql/18/docker），挂载点也从
#   /var/lib/postgresql/data 变成 /var/lib/postgresql —— 老写法会直接启动报错退出。
#   * 18.x 是当前稳定线（19 还在 beta）；想继续用老布局就固定 17.11 或更低，并按 Readme 常见问题 1 改挂载
#   * 报 manifest unknown 说明 tag 不存在，去 Docker Hub 的 postgres 页面挑一个
#     （18.6 / 18.6-alpine / 17.11 / 16.15 ...）
POSTGRES_VERSION=18.6

# 超级用户 / 密码 / 初始数据库（只在首次初始化时生效）
# 不写 POSTGRES_DB 时默认就用 POSTGRES_USER 当库名，这里显式写出来避免歧义
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=root
