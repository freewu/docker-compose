# DolphinScheduler 外部配置
# 生效方式：修改后重建对应容器即可，例如
#   docker compose up -d --force-recreate          # 全部重建
#   docker compose up -d --force-recreate ds-admin-init   # 只重跑改密码的容器

# 镜像版本（ds-standalone 与 ds-schema-init 必须用同一个版本号）
# 可用版本：3.4.3 / 3.3.2 / 3.2.2 ... 升级时改这里再 docker compose up -d
DS_VERSION=3.4.3

# 元数据库（PostgreSQL，DolphinScheduler 专用，不需要的话别动）
DS_DB_NAME=dolphinscheduler
DS_DB_USER=dolphinscheduler
DS_DB_PASSWORD=123456

# 内置管理员账号（首次启动时由 ds-admin-init 写入数据库）
# 密码没有字符限制（库里存的是 MD5），但建议 8 位以上、含字母和数字
DS_ADMIN_USER=admin
DS_ADMIN_PASSWORD=123456
