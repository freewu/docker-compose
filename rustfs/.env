# RustFS 镜像版本（Docker Hub 仓库：rustfs/rustfs；本仓库验证过 1.0.0，另有 1.0.0-glibc 变体）
RUSTFS_VERSION=1.0.0

# S3 账号密码（必填，compose 里做了非空校验；RustFS 内置默认是 rustfsadmin/rustfsadmin，别用默认值）
RUSTFS_ACCESS_KEY=rustfs
RUSTFS_SECRET_KEY=123456

# 是否开启 Web 控制台（宿主机 9021 -> 容器 9001）
RUSTFS_CONSOLE_ENABLE=true

# 日志级别：trace / debug / info / warn / error
RUSTFS_OBS_LOGGER_LEVEL=info
