# Nacos 账号密码等外部配置
# 作用：
#   * NACOS_ADMIN_PASSWORD 由 nacos-init 服务在启动时写成控制台管理员（用户名固定为 nacos）的密码
#   * NACOS_AUTH_* 是服务端鉴权相关密钥，镜像启动脚本强制要求，缺失会直接退出
# 生效方式：修改后执行 docker compose up -d --force-recreate
#          （或只重建相关容器：docker compose up -d --force-recreate nacos nacos-init）

# 镜像版本（控制台与服务端是同一个镜像，升级只改这一处）
# 3.x 端口：8080 控制台 / 8848 服务端 / 9848 gRPC；2.x 老版本控制台在 8848/nacos，端口映射要一起改
NACOS_VERSION=v3.2.4

# 鉴权开关
#   NACOS_AUTH_ENABLE         Client API（应用的注册/配置/发现请求）是否需要 accessToken
#   NACOS_AUTH_ADMIN_ENABLE   管理端 API 是否需要鉴权
#   NACOS_AUTH_CONSOLE_ENABLE 控制台是否需要登录
NACOS_AUTH_ENABLE=true
NACOS_AUTH_ADMIN_ENABLE=true
NACOS_AUTH_CONSOLE_ENABLE=true

# 服务端身份标识（服务端之间互相调用时的凭据，随便改成自己的随机串即可，务必改掉默认值）
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=243e1af8cbc333c5

# JWT 令牌签名密钥（必填）：必须是 Base64 字符串，解码后长度至少 32 字节
# 生成方式：openssl rand -base64 48
NACOS_AUTH_TOKEN=/QrmknEMbHIWB+mXWd7DE4H4+A+1uEFfCeg/8BK9SnCk2vCPK/ZFxxtfgHbVfEga

# 控制台管理员密码（必填，最长 72 字符）
# 说明：Nacos 3.x 的管理员用户名固定是 nacos（初始化接口只能创建这个名字），所以这里没有用户名的配置项；
#       密码第一次由 nacos-init 容器写入，之后改这里不会覆盖已有密码（见 Readme 常见问题 2）
NACOS_ADMIN_PASSWORD=123456

# JVM 内存（可选，不填则用镜像默认 1g/1g/512m）
#NACOS_JVM_XMS=512m
#NACOS_JVM_XMX=512m
#NACOS_JVM_XMN=256m

# 可选：Nacos 通告给客户端的地址（默认用容器主机名 nacos，只有同一 docker 网络里的容器能解析）
# * 应用跑在宿主机上（Windows/Mac 的 Docker Desktop）时，容器 IP/主机名都连不上，可填宿主机局域网 IP，
#   例如 NACOS_SERVER_IP=192.168.0.200，这样客户端会通过映射到宿主机的 8848/9848 连接
# * 应用也跑在同一个 docker 网络里时留空即可（用服务名 nacos:8848）
#NACOS_SERVER_IP=
