###############################################################################
# MySQL 8.4.x 配置（适配官方镜像 mysql:8.4.11）
#
# 挂载方式（见 docker-compose.yml）：
#   ./config/my.cnf:/etc/mysql/conf.d/my.cnf:ro
# 不要再直接覆盖 /etc/my.cnf，否则会丢掉镜像自带的
# datadir / socket / pid-file / secure-file-priv / !includedir 等关键配置。
#
# 【8.4 已移除，写了会直接启动失败(unknown variable)】
#   character-set-client-handshake = FALSE
#   skip-character-set-client-handshake
#   default_authentication_plugin        -> 改用 authentication_policy
#   log_error / log-error                -> 官方镜像错误日志走 stderr，写了 docker logs 就看不到
#   lower_case_table_names               -> 只能在初始化 datadir 时确定，事后修改会启动失败
#                                           （本配置已开启 =1，首次启动前需保证 datadir 为空）
#
# 修改后可用 `mysqld --validate-config`（容器内）校验语法
###############################################################################

[mysqld]
user                                  = mysql
port                                  = 3306
bind-address                          = 0.0.0.0
default-storage-engine                = InnoDB

# 表名不区分大小写（兼容 Windows/开发习惯）。
# 只能在数据目录初始化时确定：datadir 必须是空的（首次启动）。
# 若 datadir 已经初始化过（初始化时是默认的 0），启动会报：
#   [MY-011087] Different lower_case_table_names settings for server ('1') and data dictionary ('0')
# 解决办法二选一：
#   1) 保留 =1：清空数据目录后重启
#      docker compose down && rm -rf /data/mysql/datadir/* && docker compose up -d
#   2) 保留原数据：把本行注释掉（用默认 0，Linux 下表名区分大小写）
lower_case_table_names                = 1

# ------------------------------- 字符集 -------------------------------
# 8.4 已删除 character-set-client-handshake，服务端字符集用下面两项即可
character-set-server                  = utf8mb4
# 8.0+ 默认且更快的排序规则；若必须兼容 5.7 语义才改回 utf8mb4_unicode_ci
collation-server                      = utf8mb4_0900_ai_ci
# 对非 SUPER 用户的连接自动执行；注意不要写多条语句
init-connect                          = 'SET NAMES utf8mb4'

# ------------------------------- 时区 -------------------------------
# 配合 compose 里的 TZ=Asia/Shanghai，避免依赖 mysql 时区表
default-time-zone                     = '+08:00'

# --------------------------- 连接 / 会话 ---------------------------
# 跳过 DNS 反解，连接更快；开启后授权只能用 IP（不能用主机名）
skip-name-resolve
max_connections                       = 1000
max_connect_errors                    = 1000
max_allowed_packet                    = 64M
thread_cache_size                     = 64
table_open_cache                      = 2000
table_definition_cache                = 2000
# 会话级缓冲区按连接分配，不宜过大
sort_buffer_size                      = 4M
join_buffer_size                      = 4M
read_buffer_size                      = 2M
read_rnd_buffer_size                  = 2M
tmp_table_size                        = 64M
max_heap_table_size                   = 64M

# ------------------------------ InnoDB ------------------------------
# 按机器内存调整，建议物理内存的 50%~70%（容器需 >= 1G）
innodb_buffer_pool_size               = 512M
# buffer pool 小于 1G 时实例数保持 1
innodb_buffer_pool_instances          = 1
innodb_log_buffer_size                = 32M
# 避免双重缓存，Linux 本地盘建议开启（网络盘/overlay 异常时删掉此行）
innodb_flush_method                   = O_DIRECT
# 2 = 每次提交写 OS 缓存，宕机可能丢 1 秒事务，性能更好；要求 ACID 就改回 1
innodb_flush_log_at_trx_commit        = 2
innodb_file_per_table                 = 1
# NVMe/SSD 用 2000/4000，机械盘请改成 200/2000
innodb_io_capacity                    = 2000
innodb_io_capacity_max                = 4000
innodb_max_dirty_pages_pct            = 75

# ------------------------------ 慢查询 ------------------------------
slow_query_log                        = 1
slow_query_log_file                   = /var/lib/mysql/slow.log
long_query_time                       = 1
log_output                            = FILE
log_slow_admin_statements             = 1

# --------------------------- 可选 / 按需 ---------------------------
# 单机不需要 binlog 时可以打开，省磁盘、提升写入性能
# skip-log-bin
# 不需要 X Protocol（33060）时关闭
# mysqlx                                = OFF
# 8.4 默认禁用 mysql_native_password，旧客户端(Navicat 旧版/PHP<7.4/JDBC<8)
# 会报 "Authentication plugin cannot be loaded" / "client does not support authentication"，
# 这里显式启用并把新用户默认认证方式也设为它；若客户端较新，删掉这两行更安全。
mysql_native_password                 = ON
authentication_policy                 = mysql_native_password

[client]
# utf8mb4 支持 emoji
default-character-set                 = utf8mb4
socket                                = /var/run/mysqld/mysqld.sock

[mysql]
default-character-set                 = utf8mb4

[mysqldump]
quick
max_allowed_packet                    = 64M
default-character-set                 = utf8mb4
